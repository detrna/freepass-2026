        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "if (pm.response.code === 401 && pm.response.json().code === \"ACCESS_TOKEN_EXPIRED\") {\r",
          "    \r",
          "    pm.sendRequest({\r",
          "        url: \"http://localhost:4000/api/auth/refresh\",\r",
          "        method: \"POST\"\r",
          "    }, (err, refreshRes) => {\r",
          "        const responseData = refreshRes.json();\r",
          "        if (refreshRes.code !== 200) {\r",
          "            console.log(\"Refresh Failed Data:\", responseData);\r",
          "            return;\r",
          "        } else {\r",
          "            console.log(\"Token refreshed:\", responseData);\r",
          "        }\r",
          "    });\r",
          "}"
        ]
      }
