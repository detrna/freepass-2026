			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"if (pm.response.code === 401) {\r",
					"  const error = pm.response.json();\r",
					"\r",
					"  if (error.code === \"ACCESS_TOKEN_EXPIRED\") {\r",
					"    pm.sendRequest({\r",
					"      url: pm.environment.get(\"refresh_url\"),\r",
					"      method: \"POST\",\r",
					"      header: {\r",
					"        \"Content-Type\": \"application/json\",\r",
					"      },\r",
					"    }, function (err, res) {\r",
					"      if (err) {\r",
					"        console.error(\"Refresh failed\", err);\r",
					"        return;\r",
					"      }\r",
					"\r",
					"      const data = res.json();\r",
					"      pm.environment.set(\"access_token\", data.accessToken);\r",
					"\r",
					"      pm.sendRequest(pm.request);\r",
					"    });\r",
					"  }\r",
					"}\r",
					""
				]
			}
		}
	],
